<?xml version="1.0"?>
<robot name="leader" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Include urdf -->
    <xacro:include filename="$(find leader_description)/urdf/leader.urdf.xacro" />

    <!-- Include ros2_control hardware (current/torque mode for gravity compensation) -->
    <xacro:include filename="$(find leader_ros2_control)/description/leader.ros2_control.xacro" />

    <!-- Launch arguments -->
    <xacro:arg name="port_name" default="/dev/ttyUSB1" />

    <!-- load xacro file -->
    <xacro:leader />

    <!-- single dynamixel system: all 7 motors, effort command (Goal Current) -->
    <xacro:leader_system name="leader_system" port_name="$(arg port_name)" />
</robot>
