<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0" />
    </material>

    <xacro:macro name="nxp_omniman">
        <link name="base_footprint" />

        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <origin xyz="0 0 0.09" rpy="0 0 0" />
        </joint>

        <link name="base_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Base/Base_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Base/Base_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="11.503663" />
                <origin xyz="0.007471 -0.002650 0.013517" rpy="0 0 0" />
                <inertia ixx="0.130641" ixy="-0.005256" ixz="0.002401"
                        iyy="0.100394" iyz="-0.001007"
                        izz="0.170553" />
            </inertial>
        </link>

        <!-- ==================== Lidar ==================== -->
        <link name="lidar_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Lidar/Lidar_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Lidar/Lidar_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.446536" />
                <origin xyz="-0.000565 -0.000015 0.019299" rpy="0 0 0" />
                <inertia ixx="0.000213" ixy="0.000000" ixz="-0.000006"
                         iyy="0.000203" iyz="0.000000"
                         izz="0.000297" />
            </inertial>
        </link>

        <joint name="lidar_fixed_joint" type="fixed">
            <parent link="base_link" />
            <child link="lidar_link" />
            <origin xyz="-0.070 0.000 0.077" rpy="0 0 0" />
        </joint>

        <!-- ==================== Front_left Wheel ==================== -->

        <joint name="Front_left_couple_fixed_joint" type="fixed">
            <parent link="base_link" />
            <child link="Front_left_couple_link" />
            <origin xyz="0.091 0.087 -0.043" rpy="0 0 0" />
        </joint>

        <link name="Front_left_couple_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Front_left_wheel/Front_left_couple_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Front_left_wheel/Front_left_couple_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.079152" />
                <origin xyz="0.000000 0.010425 0.000000" rpy="0 0 0" />
                <inertia ixx="0.000016" ixy="0.000000" ixz="0.000000"
                        iyy="0.000029" iyz="0.000000"
                        izz="0.000016" />
            </inertial>
        </link>

        <!-- ==================== Rear_left Wheel ==================== -->

        <joint name="Rear_left_couple_fixed_joint" type="fixed">
            <parent link="base_link" />
            <child link="Rear_left_couple_link" />
            <origin xyz="-0.091 0.087 -0.043" rpy="0 0 0" />
        </joint>

        <link name="Rear_left_couple_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Rear_left_wheel/Rear_left_couple_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Rear_left_wheel/Rear_left_couple_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.079152" />
                <origin xyz="0.000000 0.010425 0.000000" rpy="0 0 0" />
                <inertia ixx="0.000016" ixy="0.000000" ixz="0.000000"
                        iyy="0.000029" iyz="0.000000"
                        izz="0.000016" />
            </inertial>
        </link>

        <!-- ==================== Front_right Wheel ==================== -->

        <joint name="Front_right_couple_fixed_joint" type="fixed">
            <parent link="base_link" />
            <child link="Front_right_couple_link" />
            <origin xyz="0.091 -0.087 -0.043" rpy="0 0 0" />
        </joint>

        <link name="Front_right_couple_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Front_right_wheel/Front_right_couple_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Front_right_wheel/Front_right_couple_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.079152" />
                <origin xyz="0.000000 -0.010425 0.000000" rpy="0 0 0" />
                <inertia ixx="0.000016" ixy="0.000000" ixz="0.000000"
                        iyy="0.000029" iyz="0.000000"
                        izz="0.000016" />
            </inertial>
        </link>

        <!-- ==================== Rear_right Wheel ==================== -->

        <joint name="Rear_right_couple_fixed_joint" type="fixed">
            <parent link="base_link" />
            <child link="Rear_right_couple_link" />
            <origin xyz="-0.091 -0.087 -0.043" rpy="0 0 0" />
        </joint>

        <link name="Rear_right_couple_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Rear_right_wheel/Rear_right_couple_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Rear_right_wheel/Rear_right_couple_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.079152" />
                <origin xyz="0.000000 -0.010425 0.000000" rpy="0 0 0" />
                <inertia ixx="0.000016" ixy="0.000000" ixz="0.000000"
                        iyy="0.000029" iyz="0.000000"
                        izz="0.000016" />
            </inertial>
        </link>

        <!-- ==================== Manipulator ==================== -->
        <joint name="shoulder_yaw_joint" type="revolute">
            <parent link="base_link" />
            <child link="shoulder_link" />
            <origin xyz="0.082 0.000 0.129" rpy="0 0 0" />
            <axis xyz="0 0 -1" />
            <limit effort="10" velocity="3.0" lower="-3.14" upper="3.14" />
        </joint>

        <link name="shoulder_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Shoulder_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Shoulder_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.283407" />
                <origin xyz="0.000000 -0.002915 0.032463" rpy="0 0 0" />
                <inertia ixx="0.000301" ixy="0.000000" ixz="0.0000000" 
                        iyy="0.000191" iyz="-0.000011" 
                        izz="0.000238" />
            </inertial>
        </link>

        <joint name="upper_shoulder_pitch_joint" type="revolute">
            <parent link="shoulder_link" />
            <child link="upper_shoulder_link" />
            <origin xyz="0.0 0.034 0.045" rpy="0 0 0" />
            <axis xyz="0 -1 0" />
            <limit effort="10" velocity="3.0" lower="-1.70" upper="1.70" />
        </joint>

        <link name="upper_shoulder_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Upper_shoulder_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Upper_shoulder_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.334430" />
                <origin xyz="-0.000059 -0.035570 0.043824" rpy="0 0 0" />
                <inertia ixx="0.000660" ixy="0.000000" ixz="-0.000002" 
                        iyy="0.000428" iyz="-0.000003" 
                        izz="0.000388" />
            </inertial>
        </link>

        <joint name="arm_yaw_joint" type="revolute">
            <parent link="upper_shoulder_link" />
            <child link="arm_link" />
            <origin xyz="0.0 -0.036 0.103" rpy="0 0 0" />
            <axis xyz="0 0 -1" />
            <limit effort="10" velocity="3.0" lower="-3.14" upper="3.14" />
        </joint>

        <link name="arm_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Arm_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Arm_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.283407" />
                <origin xyz="0.000000 -0.002178 0.031926" rpy="0 0 0" />
                <inertia ixx="0.000299" ixy="0.000000" ixz="0.000000" 
                        iyy="0.000189" iyz="-0.000011" 
                        izz="0.000237" />
            </inertial>
        </link>

        <joint name="forearm_pitch_joint" type="revolute">
            <parent link="arm_link" />
            <child link="forearm_link" />
            <origin xyz="0.0 0.034 0.045" rpy="0 0 0" />
            <axis xyz="0 -1 0" />
            <limit effort="10" velocity="3.0" lower="-2.33" upper="2.4" />
        </joint>

        <link name="forearm_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Forearm_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Forearm_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.332340" />
                <origin xyz="-0.000852 -0.036144 0.055987" rpy="0 0 0" />
                <inertia ixx="0.000671" ixy="0.000000" ixz="-0.000003" 
                        iyy="0.000410" iyz="0.000006" 
                        izz="0.000330" />
            </inertial>
        </link>

        <joint name="wrist_pitch_joint" type="revolute">
            <parent link="forearm_link" />
            <child link="wrist_link" />
            <origin xyz="0.0 -0.017 0.100" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <limit effort="10" velocity="3.0" lower="-1.86" upper="1.69" />
        </joint>

        <link name="wrist_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Wrist_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Wrist_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.221348" />
                <origin xyz="0.011223 -0.019000 0.037608" rpy="0 0 0" />
                <inertia ixx="0.000072" ixy="0.000000" ixz="0.000004" 
                        iyy="0.000085" iyz="0.000000" 
                        izz="0.000088" />
            </inertial>
        </link>

        <joint name="palm_yaw_joint" type="revolute">
            <parent link="wrist_link" />
            <child link="palm_link" />
            <origin xyz="0.000 -0.019 0.064" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit effort="10" velocity="3.0" lower="-3.14" upper="3.14" />
        </joint>

        <link name="palm_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Palm_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Palm_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.216056" />
                <origin xyz="0.008366 0.000000 0.026410" rpy="0 0 0" />
                <inertia ixx="0.000126" ixy="0.000000" ixz="-0.000007" 
                        iyy="0.000080" iyz="0.000000" 
                        izz="0.000145" />
            </inertial>
        </link>

        <!-- ==================== Camera =================== -->
        <joint name="camera_fixed_joint" type="fixed">
            <parent link="palm_link" />
            <child link="camera_link" />
            <origin xyz="0.008 -0.021 0.006" rpy="0 0 0" />
        </joint>

        <link name="camera_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Camera/Camera_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Camera/Camera_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.312030" />
                <origin xyz="-0.056976 0.020980 0.034842" rpy="0 0 0" />
                <inertia ixx="0.000262" ixy="0.000000" ixz="-0.000079"
                        iyy="0.000228" iyz="0.000000"
                        izz="0.000228" />
            </inertial>
        </link>

        <joint name="camera_optical_fixed_joint" type="fixed">
            <parent link="camera_link" />
            <child link="camera_optical_frame" />
            <origin xyz="-0.071 0.021 0.059" rpy="0 0 -1.5707963" />
        </joint>
        
        <link name="camera_optical_frame" />

        <joint name="gripper_prismatic_joint" type="prismatic">
            <parent link="palm_link" />
            <child link="left_finger_link" />
            <origin xyz="-0.016 -0.040 0.038" rpy="0 0 0" />
            <axis xyz="0 -1 0" />
            <limit effort="1" velocity="4.8" lower="-0.010" upper="0.019" />
        </joint>

        <joint name="right_finger_prismatic_joint" type="prismatic">
            <mimic joint="gripper_prismatic_joint" multiplier="-1.0" offset="0.0" />
            <parent link="palm_link" />
            <child link="right_finger_link" />
            <origin xyz="-0.016 0.040 0.038" rpy="0 0 0" />
            <axis xyz="0 -1 0" />
            <limit effort="1" velocity="4.8" lower="-0.019" upper="0.01" />
        </joint>

        <link name="left_finger_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Left_finger_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Left_finger_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.111661" />
                <origin xyz="0.016199 0.012512 0.036901" rpy="0 0 0" />
                <inertia ixx="0.000065" ixy="0.000000" ixz="0.000000" 
                        iyy="0.000075" iyz="0.000012" 
                        izz="0.000028" />
            </inertial>
        </link>

        <link name="right_finger_link">
            <visual>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Right_finger_link.STL" />
                </geometry>
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://omniman_description/meshes/visual/Manipulator/Right_finger_link.STL" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.111661" />
                <origin xyz="0.016201 -0.012604 0.036901" rpy="0 0 0" />
                <inertia ixx="0.000065" ixy="0.000000" ixz="0.000000" 
                        iyy="0.000075" iyz="-0.000012" 
                        izz="0.000028" />
            </inertial>
        </link>

        <joint name="ee_joint" type="fixed">
            <parent link="palm_link" />
            <child link="ee_link" />
            <origin xyz="0.000 0.000 0.080" rpy="0 0 0" />
        </joint>

        <link name="ee_link" />

    </xacro:macro>

</robot>